{
  "name": "@knovid/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "exports": { ".": "./src/index.mjs", "./http": "./src/http.mjs" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "migrate": "node --env-file-if-exists=.env src/cli.mjs migrate",
    "admin": "node --env-file-if-exists=.env src/cli.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:postgres": "node --test test/postgres.integration.mjs"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": { "@electric-sql/pglite": "0.3.14" }
}
