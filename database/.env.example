DATABASE_URL=postgresql://knovid:local-development-only@127.0.0.1:5433/knovid
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURE_COOKIES=false
SIGNUP_CREDITS=0
SESSION_TTL_SECONDS=604800
# Docker Compose local PostgreSQL only. Use a different secret for any deployment.
POSTGRES_PASSWORD=local-development-only
